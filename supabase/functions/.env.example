# Server runtime only. Never copy these names or values into frontend/.env.
# Populate only after isolated staging authorization; no real student data.
SIASET_PUBLISHABLE_KEY=
SIASET_ALLOWED_ORIGINS=http://127.0.0.1:5173
# Disabled by default; enable only in the approved synthetic test environment.
SIASET_DB2_SYNTHETIC_WRITES=disabled
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided by the function runtime.
