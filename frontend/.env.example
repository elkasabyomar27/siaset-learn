# Optional. Leave empty for unchanged anonymous browser learning.
# Use ONLY an approved staging project URL and modern publishable key.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Comma-separated https origins where accounts are offered (localhost is always allowed).
# Add an origin here ONLY after its /auth/callback and /auth/recovery URLs are in Supabase's
# Auth redirect allowlist. Unlisted origins (e.g. preview URLs) run in guest mode.
VITE_AUTH_ALLOWED_ORIGINS=
